{
  "expo": {
    "name": "Kalk",
    "slug": "gym-app",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/ios/icon-1024.png",
    "scheme": "kalk",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.putallaznicolas.gymapp",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/brand/ios/icon-1024.png",
        "dark": "./assets/brand/ios/icon-dark-1024.png",
        "tinted": "./assets/brand/ios/icon-tinted-1024.png"
      }
    },
    "android": {
      "package": "com.putallaznicolas.gymapp",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/brand/android/adaptive-foreground-1024.png",
        "monochromeImage": "./assets/brand/android/adaptive-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/web/favicon-48.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash/splash-icon-1024.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6697ea23-b360-4bc8-9cb1-74774840fd27"
      }
    },
    "owner": "putallaznicolas",
    "updates": {
      "url": "https://u.expo.dev/6697ea23-b360-4bc8-9cb1-74774840fd27"
    }
  }
}
